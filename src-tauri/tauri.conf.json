{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "firefront-gis",
  "version": "0.1.0",
  "identifier": "com.fodosoft.firefront-gis",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "firefront-gis",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "languages": [
          "French"
        ],
        "displayLanguageSelector": true
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": [
          "fr-FR"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "externalBin": [
      "binaries/7z/_7z",
      "binaries/magick/magick",
      "binaries/gdal/gdalinfo",
      "binaries/gdal/ogrinfo",
      "binaries/gdal/gdal_rasterize",
      "binaries/gdal/ogr2ogr",
      "binaries/gdal/gdal_translate",
      "binaries/gdal/gdalwarp",
      "binaries/gdal/gdal_create",
      "binaries/gdal/gdalbuildvrt",
      "binaries/gdal/gdaldem"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DonatFortini/firefront-gis/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RTdCNUQ5N0UwREZEQjIKUldTeS9RMSsyYlhuUnpmRHdMVU9SRU16MjMwelZ2c0xEMUR1cS9xN2EzREx3NTkrWXVkeTdhU3gK"
    }
  }
}
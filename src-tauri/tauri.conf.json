{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "firefront-gis",
  "version": "0.3.4",
  "identifier": "com.fodosoft.firefront-gis",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Firefront GIS",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "focus": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "skipTaskbar": false,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "contentProtected": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri:",
        "connect-src": "'self' https://geoservices.ign.fr https://data.geopf.fr https://github.com ipc: http://ipc.localhost tauri:",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline'",
        "style-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost http://localhost https: tauri: data:",
        "font-src": "'self' data:"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/projects/**",
            "$APPDATA/cache/wms/**"
          ]
        }
      },
      "capabilities": [
        "main",
        "desktop"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "windows": {
      "allowDowngrades": false,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "languages": [
          "French"
        ],
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "lzma"
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": [
          "fr-FR"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/regions.db",
      "resources/proj/**/*",
      "resources/gdal/**/*"
    ],
    "externalBin": [
      "binaries/7z/_7z",
      "binaries/magick/magick",
      "binaries/gdal/gdalinfo",
      "binaries/gdal/ogrinfo",
      "binaries/gdal/gdal_rasterize",
      "binaries/gdal/ogr2ogr",
      "binaries/gdal/gdal_translate",
      "binaries/gdal/gdalwarp",
      "binaries/gdal/gdal_create",
      "binaries/gdal/gdalbuildvrt",
      "binaries/gdal/gdaldem"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DonatFortini/firefront-gis/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RTdCNUQ5N0UwREZEQjIKUldTeS9RMSsyYlhuUnpmRHdMVU9SRU16MjMwelZ2c0xEMUR1cS9xN2EzREx3NTkrWXVkeTdhU3gK"
    }
  }
}
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main application capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/7z/_7z",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/magick/magick",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdalinfo",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/ogrinfo",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdal_rasterize",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/ogr2ogr",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdal_translate",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdalwarp",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdal_create",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdalbuildvrt",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdaldem",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
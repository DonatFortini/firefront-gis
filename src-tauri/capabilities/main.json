{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main application capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-center",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:path:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:allow-open",
    "dialog:allow-message",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/7z/_7z",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/magick/magick",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdalinfo",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/ogrinfo",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdal_rasterize",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/ogr2ogr",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdal_translate",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdalwarp",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdal_create",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdalbuildvrt",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/gdal/gdaldem",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}